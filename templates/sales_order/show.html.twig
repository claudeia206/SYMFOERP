{% extends 'base.html.twig' %}
{% block title %}{{ order.number }} · SYMFOERP{% endblock %}
{% block body %}
    <p class="muted">GESTION COMMERCIALE / VENTES</p>
    <p><a href="{{ path('app_sales_orders') }}">← Toutes les commandes</a></p>
    {% for message in app.flashes('success') %}<p class="card" role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p class="card" role="alert">{{ message }}</p>{% endfor %}
    <h1>{{ order.number }}</h1>
    <section class="card">
        <p><strong>Client :</strong> {{ order.customer.name }}</p>
        <p><strong>Commande créée le :</strong> {{ order.orderDate|date('d/m/Y') }}</p>
        <p><strong>Devis d'origine :</strong> <a href="{{ path('app_sales_quote_show', {id: order.sourceQuote.id}) }}">{{ order.sourceQuote.number }}</a></p>
        <p><strong>Statut :</strong> {{ statuses[order.status] ?? order.status }}</p>
        <p><a href="{{ path('app_sales_invoices') }}">Consulter les factures</a></p>
        <form method="post" action="{{ path('app_sales_invoice_from_order', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sales_invoice_create_' ~ order.id) }}">
            <button type="submit">Préparer une facture brouillon</button>
        </form>
    </section>
    <section class="card">
        <h2>Lignes de commande</h2>
        <div class="table-scroll"><table class="data-table">
            <thead><tr><th>Désignation</th><th>Commandé</th><th>Déjà livré</th><th>Reliquat</th><th>Prix unitaire HT</th><th>TVA</th><th>Total TTC</th></tr></thead>
            <tbody>{% for line in order.lines %}
                <tr><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.deliveredQuantity }}</td><td>{{ line.remainingQuantity }}</td><td>{{ line.unitPrice|number_format(2, ',', ' ') }} €</td><td>{{ line.vatRate|number_format(2, ',', ' ') }} %</td><td>{{ line.totalIncludingTax|number_format(2, ',', ' ') }} €</td></tr>
            {% endfor %}</tbody>
        </table></div>
        <dl><dt>Total HT</dt><dd>{{ order.totalExcludingTax|number_format(2, ',', ' ') }} €</dd><dt>Total TVA</dt><dd>{{ order.totalTax|number_format(2, ',', ' ') }} €</dd><dt><strong>Total TTC</strong></dt><dd><strong>{{ order.totalIncludingTax|number_format(2, ',', ' ') }} €</strong></dd></dl>
        {% if order.notes %}<h3>Notes et conditions</h3><p>{{ order.notes|nl2br }}</p>{% endif %}
    </section>
    {% if order.status == 'open' %}
    <section class="card">
        <h2>Créer un bon de livraison</h2>
        <p class="muted">Saisissez les quantités expédiées aujourd’hui. Laissez à zéro ou vide les lignes non livrées. Une livraison partielle conserve la commande ouverte.</p>
        <form method="post" action="{{ path('app_sales_order_delivery_create', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sales_order_delivery_' ~ order.id) }}">
            <div class="table-scroll"><table class="data-table">
                <thead><tr><th>Article</th><th>Reliquat</th><th>Quantité à livrer</th></tr></thead>
                <tbody>{% for line in order.lines %}
                    <tr>
                        <td>{{ line.description }}</td>
                        <td>{{ line.remainingQuantity }}</td>
                        <td><input type="number" name="quantities[{{ line.id }}]" min="0" max="{{ line.remainingQuantity }}" step="0.001" value="0" aria-label="Quantité à livrer pour {{ line.description }}"></td>
                    </tr>
                {% endfor %}</tbody>
            </table></div>
            <label for="delivery-notes">Observations de livraison</label>
            <textarea id="delivery-notes" name="notes" rows="2" maxlength="2000"></textarea>
            <button type="submit">Enregistrer le bon de livraison</button>
        </form>
    </section>
    {% endif %}
    <section class="card">
        <h2>Historique des livraisons</h2>
        {% if deliveries is empty %}
            <p class="muted">Aucun bon de livraison enregistré pour cette commande.</p>
        {% else %}
            <div class="table-scroll"><table class="data-table">
                <thead><tr><th>Numéro</th><th>Date</th><th>Désignation</th><th>Quantité livrée</th><th>Observations</th><th>Document</th></tr></thead>
                <tbody>{% for delivery in deliveries %}
                    {% for line in delivery.lines %}
                    <tr>
                        <td>{{ delivery.number }}</td><td>{{ delivery.deliveryDate|date('d/m/Y') }}</td>
                        <td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ delivery.notes ?: '—' }}</td><td><a href="{{ path('app_sales_delivery_pdf', {id: order.id, deliveryId: delivery.id}) }}">Télécharger le PDF</a></td>
                    </tr>
                    {% endfor %}
                {% endfor %}</tbody>
            </table></div>
        {% endif %}
    </section>

    <section class="card">
        <h2>Enregistrer un retour client</h2>
        <p class="muted">Un retour ne peut concerner que des quantités déjà livrées et pas encore retournées. Les quantités acceptées sont réintégrées au stock suivi.</p>
        <form method="post" action="{{ path('app_sales_return_create', {id: order.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('sales_return_' ~ order.id) }}">
            <div class="table-scroll"><table class="data-table">
                <thead><tr><th>Article</th><th>Livré</th><th>Déjà retourné</th><th>Encore retournable</th><th>Quantité reçue</th></tr></thead>
                <tbody>{% for line in order.lines %}
                    <tr><td>{{ line.description }}</td><td>{{ line.deliveredQuantity }}</td><td>{{ line.returnedQuantity }}</td><td>{{ line.returnableQuantity }}</td>
                    <td><input type="number" name="quantities[{{ line.id }}]" min="0" max="{{ line.returnableQuantity }}" step="0.001" value="0" aria-label="Quantité retournée pour {{ line.description }}"></td></tr>
                {% endfor %}</tbody>
            </table></div>
            <label for="return-notes">Motif / observations du retour</label>
            <textarea id="return-notes" name="notes" rows="2" maxlength="2000"></textarea>
            <button type="submit">Enregistrer le retour client</button>
        </form>
    </section>
    <section class="card">
        <h2>Historique des retours</h2>
        {% if returns is empty %}
            <p class="muted">Aucun retour enregistré pour cette commande.</p>
        {% else %}
            <div class="table-scroll"><table class="data-table">
                <thead><tr><th>Numéro</th><th>Date</th><th>Article</th><th>Quantité retournée</th><th>Observations</th></tr></thead>
                <tbody>{% for salesReturn in returns %}
                    {% for line in salesReturn.lines %}
                    <tr><td>{{ salesReturn.number }}</td><td>{{ salesReturn.returnDate|date('d/m/Y') }}</td><td>{{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ salesReturn.notes ?: '—' }}</td></tr>
                    {% endfor %}
                {% endfor %}</tbody>
            </table></div>
        {% endif %}
    </section>

    {% if allowed_actions is not empty %}<section class="card"><h2>Actions sur la commande</h2>{% for action in allowed_actions %}
        <form method="post" action="{{ path('app_sales_order_status', {id: order.id}) }}" style="display:inline-block;margin:6px 10px 6px 0"><input type="hidden" name="_token" value="{{ csrf_token('sales_order_status_' ~ order.id) }}"><input type="hidden" name="status" value="{{ action }}"><button type="submit">{{ statuses[action] }}</button></form>
    {% endfor %}</section>{% endif %}
{% endblock %}
