{% extends 'base.html.twig' %}
{% block title %}Immobilisations{% endblock %}
{% block body %}
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4"><h1>Immobilisations & amortissements</h1><span class="text-muted">Simulation au {{ as_of }}</span></div>
  {% for message in app.flashes('error') %}<div class="alert alert-danger">{{ message }}</div>{% endfor %}
  {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message }}</div>{% endfor %}
  <div class="card mb-4"><div class="card-header">Nouvelle immobilisation</div><div class="card-body">
    <form method="post" action="{{ path('app_fixed_assets_create') }}" class="row g-3">
      <input type="hidden" name="_token" value="{{ csrf_token('fixed_asset_create') }}">
      <div class="col-md-2"><label class="form-label">Code</label><input class="form-control" name="code" required maxlength="64"></div>
      <div class="col-md-4"><label class="form-label">Désignation</label><input class="form-control" name="name" required maxlength="255"></div>
      <div class="col-md-2"><label class="form-label">Coût (€)</label><input class="form-control" name="acquisition_cost" type="number" min="0.01" step="0.01" required></div>
      <div class="col-md-2"><label class="form-label">Valeur résiduelle (€)</label><input class="form-control" name="residual_value" type="number" min="0" step="0.01" value="0" required></div>
      <div class="col-md-2"><label class="form-label">Durée (années)</label><input class="form-control" name="useful_life_years" type="number" min="1" max="100" required></div>
      <div class="col-md-3"><label class="form-label">Mise en service</label><input class="form-control" name="in_service_date" type="date" required></div>
      <div class="col-md-3"><label class="form-label">Compte immobilisation</label><select class="form-select" name="asset_account_id" required><option value="">Choisir…</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.code }} — {{ account.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Compte amortissements</label><select class="form-select" name="accumulated_account_id" required><option value="">Choisir…</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.code }} — {{ account.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Compte dotations</label><select class="form-select" name="expense_account_id" required><option value="">Choisir…</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.code }} — {{ account.name }}</option>{% endfor %}</select></div>
      <div class="col-md-3"><label class="form-label">Journal de dotation / cession</label><select class="form-select" name="journal_id" required><option value="">Choisir…</option>{% for journal in journals %}<option value="{{ journal.id }}">{{ journal.code }} — {{ journal.name }}</option>{% endfor %}</select></div>
      <div class="col-md-4"><label class="form-label">Compte banque / créance de cession</label><select class="form-select" name="disposal_bank_account_id" required><option value="">Choisir…</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.code }} — {{ account.name }}</option>{% endfor %}</select></div>
      <div class="col-md-4"><label class="form-label">Compte plus-value</label><select class="form-select" name="disposal_gain_account_id" required><option value="">Choisir…</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.code }} — {{ account.name }}</option>{% endfor %}</select></div>
      <div class="col-md-4"><label class="form-label">Compte moins-value</label><select class="form-select" name="disposal_loss_account_id" required><option value="">Choisir…</option>{% for account in accounts %}<option value="{{ account.id }}">{{ account.code }} — {{ account.name }}</option>{% endfor %}</select></div>
      <div class="col-12"><button class="btn btn-primary">Enregistrer</button></div>
    </form>
  </div></div>
  <div class="card"><div class="card-header">Registre et plan prévisionnel</div><div class="table-responsive"><table class="table table-striped mb-0">
    <thead><tr><th>Code</th><th>Immobilisation</th><th>Coût</th><th>Durée</th><th>Année</th><th>Dotation</th><th>Amorti cumulé</th><th>VNC</th><th>Comptabilisation</th><th>Statut</th><th></th></tr></thead><tbody>
    {% for asset in assets %}
      {% set plan = plans[asset.id] %}
      {% if plan is empty %}<tr><td>{{ asset.code }}</td><td>{{ asset.name }}</td><td>{{ asset.acquisition_cost|number_format(2, ',', ' ') }} €</td><td>{{ asset.useful_life_years }} ans</td><td colspan="5">Aucune dotation à la date choisie</td><td>{{ asset.status }}</td><td></td></tr>
      {% else %}{% for line in plan %}<tr>
        <td>{{ asset.code }}</td><td>{{ asset.name }}</td><td>{{ asset.acquisition_cost|number_format(2, ',', ' ') }} €</td><td>{{ asset.useful_life_years }} ans</td><td>{{ line.period }}</td>
        <td>{{ line.amount|number_format(2, ',', ' ') }} €</td><td>{{ line.accumulated|number_format(2, ',', ' ') }} €</td><td>{{ line.net_book_value|number_format(2, ',', ' ') }} €</td>
        <td>{% if posted_map[asset.id][line.period] is defined %}<span class="badge bg-success">Comptabilisé : {{ posted_map[asset.id][line.period]|number_format(2, ',', ' ') }} €</span>{% elseif asset.status == 'active' %}<form method="post" action="{{ path('app_fixed_assets_depreciation_post',{id:asset.id,year:line.period}) }}" onsubmit="return confirm('Comptabiliser la dotation {{ line.amount|number_format(2, ',', ' ') }} € pour {{ line.period }} ?');"><input type="hidden" name="_token" value="{{ csrf_token('fixed_asset_depreciation_' ~ asset.id ~ '_' ~ line.period) }}"><button class="btn btn-sm btn-primary">Comptabiliser</button></form>{% else %}<span class="text-muted">—</span>{% endif %}</td>
        <td>{{ asset.status }}</td><td>{% if asset.status == 'active' and loop.last %}<form method="post" action="{{ path('app_fixed_assets_dispose',{id:asset.id}) }}" class="mb-2"><input type="hidden" name="_token" value="{{ csrf_token('fixed_asset_dispose_' ~ asset.id) }}"><input class="form-control form-control-sm mb-1" type="date" name="disposal_date" value="{{ as_of|date('Y') }}-12-31" required><input class="form-control form-control-sm mb-1" type="number" name="disposal_proceeds" min="0" step="0.01" placeholder="Prix de cession (€)" required><button class="btn btn-sm btn-danger">Céder / sortir</button></form><form method="post" action="{{ path('app_fixed_assets_archive',{id:asset.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('fixed_asset_archive_' ~ asset.id) }}"><button class="btn btn-sm btn-outline-secondary">Archiver</button></form>{% elseif asset.status == 'disposed' %}<span class="text-muted">Sortie : {{ asset.disposal_date }}</span>{% endif %}</td>
      </tr>{% endfor %}{% endif %}
    {% else %}<tr><td colspan="11" class="text-center text-muted">Aucune immobilisation enregistrée.</td></tr>{% endfor %}
    </tbody></table></div></div>
  <p class="text-muted small mt-3">Les dotations sont calculées au prorata temporis. Chaque comptabilisation est une action explicite, crée une écriture équilibrée débit/crédit et ne peut être répétée pour le même exercice. Valider le paramétrage comptable et les règles applicables avant utilisation en production.</p>
</div>
{% endblock %}