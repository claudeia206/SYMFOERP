{% extends 'base.html.twig' %}
{% block title %}Comptabilité générale · SYMFOERP{% endblock %}
{% block stylesheets %}<style>
.accounting-head{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px}.accounting-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:24px}.accounting-card{background:#fff;border:1px solid #e5eaf1;border-radius:12px;padding:18px}.accounting-card strong{display:block;font-size:26px;margin-top:5px}.accounting-panel{background:#fff;border:1px solid #e5eaf1;border-radius:12px;margin-bottom:22px;overflow:hidden}.accounting-panel h2{font-size:18px;padding:16px 18px;margin:0;border-bottom:1px solid #e5eaf1}.accounting-panel .inner{padding:16px 18px}.accounting-table{width:100%;border-collapse:collapse}.accounting-table th,.accounting-table td{padding:11px 13px;border-bottom:1px solid #e5eaf1;text-align:left}.accounting-table th{font-size:13px;color:#64748b}.accounting-table .right{text-align:right}.accounting-columns{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px}.accounting-muted{color:#64748b}.accounting-pill{font-size:12px;padding:4px 8px;border-radius:20px;background:#e8f5ed;color:#17663a}.accounting-pill.draft{background:#eef2f7;color:#475569}@media(max-width:760px){.accounting-columns{grid-template-columns:1fr}.accounting-head{align-items:flex-start;flex-direction:column}}
</style>{% endblock %}
{% block body %}
<div class="accounting-wrap">
 <div class="accounting-head"><div><h1>Comptabilité générale</h1><p class="text-muted mb-0">Plan comptable, journaux, exercices et écritures.</p></div><span class="accounting-pill">Socle initial</span></div>
 <div class="accounting-grid">
  <div class="accounting-card"><small class="text-muted">Comptes actifs</small><strong class="fs-3">{{ accounts|length }}</strong></div>
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Journaux actifs</small><strong class="fs-3">{{ journals|length }}</strong></div></div>
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Exercices</small><strong class="fs-3">{{ years|length }}</strong></div></div>
  <div class="col-md-3"><div class="card card-body"><small class="text-muted">Écritures affichées</small><strong class="fs-3">{{ entries|length }}</strong></div></div>
 </div>
 <div class="accounting-panel"><h2>Écritures récentes</h2><div class="table-responsive"><table class="accounting-table"><thead><tr><th>Date</th><th>Journal</th><th>N° écriture</th><th>Libellé</th><th>Statut</th><th class="right">Débit</th><th class="text-end">Crédit</th></tr></thead><tbody>
 {% for entry in entries %}{% set t=entry.totals %}<tr><td>{{ entry.entryDate|date('d/m/Y') }}</td><td>{{ entry.journal.code }}</td><td>{{ entry.number }}</td><td>{{ entry.label }}</td><td><span class="accounting-pill {{ entry.status == 'posted' ? '' : 'draft' }}">{{ entry.status }}</span></td><td class="right">{{ (t.debit / 100)|number_format(2,',',' ') }} €</td><td class="text-end">{{ (t.credit / 100)|number_format(2,',',' ') }} €</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">Aucune écriture. Le socle comptable est installé, le paramétrage du plan et la saisie arrivent ensuite.</td></tr>{% endfor %}
 </tbody></table></div></div>
 <div class="accounting-columns"><div class="accounting-panel"><h2>Plan comptable</h2><div class="inner">{% for account in accounts %}<div class="d-flex justify-content-between border-bottom py-2"><strong>{{ account.number }}</strong><span>{{ account.label }}</span></div>{% else %}<p class="text-muted mb-0">Aucun compte configuré.</p>{% endfor %}</div></div></div>
 <div class="accounting-panel"><h2>Journaux</h2><div class="inner">{% for journal in journals %}<p class="mb-2"><strong>{{ journal.code }}</strong> — {{ journal.label }}</p>{% else %}<p class="text-muted">Aucun journal.</p>{% endfor %}</div></div></div>
 <div class="accounting-panel"><h2>Exercices</h2><div class="inner">{% for year in years %}<p class="mb-2"><strong>{{ year.code }}</strong><br><small>{{ year.startsOn|date('d/m/Y') }} – {{ year.endsOn|date('d/m/Y') }}</small> {% if year.closed %}<span class="accounting-pill draft">Clôturé</span>{% else %}<span class="accounting-pill">Ouvert</span>{% endif %}</p>{% else %}<p class="text-muted">Aucun exercice.</p>{% endfor %}</div></div></div></div>
</div>
{% endblock %}