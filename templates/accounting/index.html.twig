{% extends 'base.html.twig' %}
{% block title %}Comptabilité générale · SYMFOERP{% endblock %}
{% block stylesheets %}<style>
.accounting-head{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px}.accounting-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:24px}.accounting-card,.accounting-panel{background:#fff;border:1px solid #e5eaf1;border-radius:12px}.accounting-card{padding:18px}.accounting-card strong{display:block;font-size:26px;margin-top:5px}.accounting-panel{margin-bottom:22px;overflow:hidden}.accounting-panel h2{font-size:18px;padding:16px 18px;margin:0;border-bottom:1px solid #e5eaf1}.accounting-inner{padding:16px 18px}.accounting-table{width:100%;border-collapse:collapse}.accounting-table th,.accounting-table td{padding:11px 13px;border-bottom:1px solid #e5eaf1;text-align:left}.accounting-table th{font-size:13px;color:#64748b}.accounting-table .right{text-align:right}.accounting-columns{display:grid;grid-template-columns:2fr 1fr 1fr;gap:16px}.accounting-pill{font-size:12px;padding:4px 8px;border-radius:20px;background:#e8f5ed;color:#17663a}.accounting-pill.draft{background:#eef2f7;color:#475569}.accounting-row{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #e5eaf1;padding:9px 0}@media(max-width:760px){.accounting-columns{grid-template-columns:1fr}.accounting-head{align-items:flex-start;flex-direction:column}}
</style>{% endblock %}
{% block body %}
<div>
 {% for message in app.flashes('success') %}<p class="accounting-pill">{{ message }}</p>{% endfor %}
 {% for message in app.flashes('error') %}<p class="accounting-pill draft">{{ message }}</p>{% endfor %}
 <div class="accounting-head"><div><h1>Comptabilité générale</h1><p>Plan comptable, journaux, exercices et écritures.</p></div><a href="{{ path('app_accounting_entry_new') }}" class="accounting-pill">+ Nouvelle écriture</a></div>
 <div class="accounting-grid">
  <div class="accounting-card"><small>Comptes actifs</small><strong>{{ accounts|length }}</strong></div>
  <div class="accounting-card"><small>Journaux actifs</small><strong>{{ journals|length }}</strong></div>
  <div class="accounting-card"><small>Exercices</small><strong>{{ years|length }}</strong></div>
  <div class="accounting-card"><small>Écritures affichées</small><strong>{{ entries|length }}</strong></div>
 </div>
 <section class="accounting-panel"><h2>Écritures récentes</h2><div style="overflow-x:auto"><table class="accounting-table"><thead><tr><th>Date</th><th>Journal</th><th>N° écriture</th><th>Libellé</th><th>Statut</th><th class="right">Débit</th><th class="right">Crédit</th></tr></thead><tbody>
 {% for entry in entries %}{% set t=entry.totals %}<tr><td>{{ entry.entryDate|date('d/m/Y') }}</td><td>{{ entry.journal.code }}</td><td>{{ entry.number }}</td><td>{{ entry.label }}</td><td><span class="accounting-pill {{ entry.status == 'posted' ? '' : 'draft' }}">{{ entry.status }}</span></td><td class="right">{{ (t.debit / 100)|number_format(2,',',' ') }} €</td><td class="right">{{ (t.credit / 100)|number_format(2,',',' ') }} €</td></tr>{% else %}<tr><td colspan="7">Aucune écriture. Le plan comptable et les journaux de base sont initialisés.</td></tr>{% endfor %}
 </tbody></table></div></section>
 <div class="accounting-columns">
  <section class="accounting-panel"><h2>Plan comptable</h2><div class="accounting-inner">{% for account in accounts %}<div class="accounting-row"><strong>{{ account.number }}</strong><span>{{ account.label }}</span></div>{% else %}<p>Aucun compte configuré.</p>{% endfor %}</div></section>
  <section class="accounting-panel"><h2>Journaux</h2><div class="accounting-inner">{% for journal in journals %}<p><strong>{{ journal.code }}</strong> — {{ journal.label }}</p>{% else %}<p>Aucun journal.</p>{% endfor %}</div></section>
  <section class="accounting-panel"><h2>Exercices</h2><div class="accounting-inner">{% for year in years %}<p><strong>{{ year.code }}</strong><br><small>{{ year.startsOn|date('d/m/Y') }} – {{ year.endsOn|date('d/m/Y') }}</small><br>{% if year.closed %}<span class="accounting-pill draft">Clôturé</span>{% else %}<span class="accounting-pill">Ouvert</span>{% endif %}</p>{% else %}<p>Aucun exercice.</p>{% endfor %}</div></section>
 </div>
</div>
{% endblock %}