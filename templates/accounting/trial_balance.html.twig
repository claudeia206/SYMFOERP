{% extends 'base.html.twig' %}
{% block title %}Balance générale · SYMFOERP{% endblock %}
{% block stylesheets %}<style>
.report-panel{background:white;border:1px solid #e5eaf1;border-radius:12px;overflow:hidden}.report-panel h2{font-size:18px;padding:16px 18px;margin:0;border-bottom:1px solid #e5eaf1}.report-inner{padding:18px}.report-filter{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin-bottom:18px}.report-filter label{display:block;font-size:13px;font-weight:600;margin-bottom:5px}.report-filter input{padding:9px;border:1px solid #cbd5e1;border-radius:7px}.report-button{padding:10px 15px;background:#174ea6;color:#fff;border:0;border-radius:7px;text-decoration:none}.report-table{width:100%;border-collapse:collapse}.report-table th,.report-table td{padding:11px 12px;border-bottom:1px solid #e5eaf1;text-align:left}.report-table th{font-size:13px;color:#64748b}.report-table .num{text-align:right;font-variant-numeric:tabular-nums}.report-nav{display:flex;gap:18px;margin:12px 0 20px}.report-nav a{color:#174ea6}@media(max-width:700px){.report-table{min-width:720px}.report-scroll{overflow-x:auto}}
</style>{% endblock %}
{% block body %}
<p><a href="{{ path('app_accounting') }}">← Comptabilité</a></p><h1>Balance générale</h1><p class="muted">Soldes d’ouverture, mouvements de période et soldes de clôture des écritures comptabilisées.</p>
<nav class="report-nav"><a href="{{ path('app_accounting') }}">Tableau de bord</a><a href="{{ path('app_accounting_trial_balance') }}">Balance générale</a></nav>
<form class="report-filter" method="get"><div><label for="from">Du</label><input id="from" type="date" name="from" value="{{ from|date('Y-m-d') }}" required></div><div><label for="to">Au</label><input id="to" type="date" name="to" value="{{ to|date('Y-m-d') }}" required></div><button class="report-button">Afficher</button></form>
<section class="report-panel"><h2>Balance du {{ from|date('d/m/Y') }} au {{ to|date('d/m/Y') }}</h2><div class="report-inner report-scroll"><table class="report-table"><thead><tr><th>Compte</th><th>Intitulé</th><th class="num">Solde d’ouverture</th><th class="num">Débit période</th><th class="num">Crédit période</th><th class="num">Solde de clôture</th></tr></thead><tbody>
{% for row in rows %}<tr><td><a href="{{ path('app_accounting_ledger',{'id':row.accountId,'from':from|date('Y-m-d'),'to':to|date('Y-m-d')}) }}">{{ row.accountNumber }}</a></td><td>{{ row.accountLabel }}</td><td class="num">{{ (row.openingBalanceCents / 100)|number_format(2,',',' ') }} €</td><td class="num">{{ (row.debitCents / 100)|number_format(2,',',' ') }} €</td><td class="num">{{ (row.creditCents / 100)|number_format(2,',',' ') }} €</td><td class="num">{{ (row.balanceCents / 100)|number_format(2,',',' ') }} €</td></tr>{% else %}<tr><td colspan="6">Aucun mouvement comptabilisé avant ou pendant cette période.</td></tr>{% endfor %}
</tbody><tfoot><tr><th colspan="2">Totaux</th><th class="num">{{ (openingBalanceTotal / 100)|number_format(2,',',' ') }} €</th><th class="num">{{ (debitTotal / 100)|number_format(2,',',' ') }} €</th><th class="num">{{ (creditTotal / 100)|number_format(2,',',' ') }} €</th><th class="num">{{ (closingBalanceTotal / 100)|number_format(2,',',' ') }} €</th></tr></tfoot></table></div></section>
{% endblock %}