{% extends 'base.html.twig' %}
{% block title %}Grand livre {{ account.number }} · SYMFOERP{% endblock %}
{% block stylesheets %}<style>
.report-panel{background:white;border:1px solid #e5eaf1;border-radius:12px;overflow:hidden}.report-panel h2{font-size:18px;padding:16px 18px;margin:0;border-bottom:1px solid #e5eaf1}.report-inner{padding:18px}.report-filter{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin-bottom:18px}.report-filter label{display:block;font-size:13px;font-weight:600;margin-bottom:5px}.report-filter input{padding:9px;border:1px solid #cbd5e1;border-radius:7px}.report-button{padding:10px 15px;background:#174ea6;color:#fff;border:0;border-radius:7px}.report-table{width:100%;border-collapse:collapse}.report-table th,.report-table td{padding:11px 12px;border-bottom:1px solid #e5eaf1;text-align:left}.report-table th{font-size:13px;color:#64748b}.report-table .num{text-align:right;font-variant-numeric:tabular-nums}@media(max-width:700px){.report-table{min-width:850px}.report-scroll{overflow-x:auto}}
</style>{% endblock %}
{% block body %}
<p><a href="{{ path('app_accounting_trial_balance') }}">← Retour à la balance</a></p><h1>Grand livre</h1><p><strong>{{ account.number }}</strong> — {{ account.label }}</p>
<form class="report-filter" method="get"><div><label for="from">Du</label><input id="from" type="date" name="from" value="{{ from|date('Y-m-d') }}" required></div><div><label for="to">Au</label><input id="to" type="date" name="to" value="{{ to|date('Y-m-d') }}" required></div><button class="report-button">Afficher</button></form>
<section class="report-panel"><h2>Mouvements du {{ from|date('d/m/Y') }} au {{ to|date('d/m/Y') }}</h2><div class="report-inner report-scroll"><table class="report-table"><thead><tr><th>Date</th><th>Journal</th><th>N° écriture</th><th>Libellé</th><th class="num">Débit</th><th class="num">Crédit</th><th class="num">Solde progressif</th></tr></thead><tbody>
{% for movement in movements %}{% set line=movement.line %}{% set entry=line.entry %}<tr><td>{{ entry.entryDate|date('d/m/Y') }}</td><td>{{ entry.journal.code }}</td><td>{{ entry.number }}</td><td>{{ line.label }}</td><td class="num">{{ (line.debitCents / 100)|number_format(2,',',' ') }} €</td><td class="num">{{ (line.creditCents / 100)|number_format(2,',',' ') }} €</td><td class="num">{{ (movement.balance / 100)|number_format(2,',',' ') }} €</td></tr>{% else %}<tr><td colspan="7">Aucun mouvement sur cette période.</td></tr>{% endfor %}
</tbody><tfoot><tr><th colspan="4">Totaux / solde</th><th class="num">{{ (totalDebit / 100)|number_format(2,',',' ') }} €</th><th class="num">{{ (totalCredit / 100)|number_format(2,',',' ') }} €</th><th class="num">{{ (balance / 100)|number_format(2,',',' ') }} €</th></tr></tfoot></table></div></section>
{% endblock %}