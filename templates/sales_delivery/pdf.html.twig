<!doctype html>
<html lang="fr"><head><meta charset="UTF-8"><style>
body{font-family:DejaVu Sans,sans-serif;color:#20242b;font-size:11px}h1{font-size:24px;margin-bottom:4px}.muted{color:#68717d}.meta{margin:24px 0;padding:12px;border:1px solid #d9dee5}table{width:100%;border-collapse:collapse;margin-top:24px}th,td{padding:9px;border-bottom:1px solid #d9dee5;text-align:left}th{background:#f1f3f5}.qty{text-align:right}.notes{margin-top:24px;padding:12px;background:#f7f8fa}
</style></head><body>
<p class="muted">SYMFOERP · GESTION COMMERCIALE</p>
<h1>Bon de livraison {{ delivery.number }}</h1>
<p class="muted">Document de livraison · {{ delivery.deliveryDate|date('d/m/Y') }}</p>
<div class="meta">
<p><strong>Client :</strong> {{ order.customer.name }}</p>
<p><strong>Commande :</strong> {{ order.number }}</p>
<p><strong>Date de commande :</strong> {{ order.orderDate|date('d/m/Y') }}</p>
</div>
<table><thead><tr><th>Désignation</th><th class="qty">Quantité livrée</th></tr></thead><tbody>
{% for line in delivery.lines %}<tr><td>{{ line.description }}</td><td class="qty">{{ line.quantity }}</td></tr>{% endfor %}
</tbody></table>
{% if delivery.notes %}<div class="notes"><strong>Observations :</strong><br>{{ delivery.notes|nl2br }}</div>{% endif %}
<p class="muted" style="margin-top:48px">Document généré par SYMFOERP.</p>
</body></html>
