{% extends 'base.html.twig' %}
{% block title %}Compte {{ account.code }} · SYMFOERP{% endblock %}
{% block body %}
<p class="muted"><a href="{{ path('app_general_ledger') }}">Comptabilité générale</a> / Grand livre</p>
<h1>{{ account.code }} — {{ account.name }}</h1>
<form method="get" style="display:flex;gap:12px;flex-wrap:wrap;align-items:end">
<label>Du <input type="date" name="from" value="{{ from }}" required></label>
<label>Au <input type="date" name="to" value="{{ to }}" required></label>
<button type="submit">Actualiser</button>
</form>
<section class="card">
<div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Journal</th><th>N°</th><th>Référence</th><th>Écriture</th><th>Libellé</th><th>Débit</th><th>Crédit</th><th>Solde</th></tr></thead><tbody>
{% for line in lines %}<tr><td>{{ line.entry_date|date('d/m/Y') }}</td><td>{{ line.journal_code }}</td><td>{{ '%06d'|format(line.entry_number) }}</td><td>{{ line.reference ?: '—' }}</td><td>{{ line.description }}</td><td>{{ line.label }}</td><td>{{ line.debit|number_format(2,',',' ') }} €</td><td>{{ line.credit|number_format(2,',',' ') }} €</td><td>{{ line.balance|abs|number_format(2,',',' ') }} € {{ line.balance>0?'D':(line.balance<0?'C':'—') }}</td></tr>{% else %}<tr><td colspan="9">Aucun mouvement sur cette période.</td></tr>{% endfor %}
</tbody></table></div>
<p><strong>Solde de la période : {{ balance|abs|number_format(2,',',' ') }} € {{ balance>0?'débiteur':(balance<0?'créditeur':'nul') }}</strong></p>
</section>
{% endblock %}
