<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SYMFOERP{% endblock %}</title>
    <style>
        :root { font-family: Inter, system-ui, sans-serif; color: #172033; background: #f4f6fa; }
        * { box-sizing: border-box; } body { margin: 0; }
        header { display:flex; align-items:center; justify-content:space-between; padding:18px 5vw; color:white; background:#172b4d; }
        header strong { letter-spacing:.08em; } header nav { display:flex; gap:18px; } header nav a { color:#dbeafe; text-decoration:none; } header nav a:hover { text-decoration:underline; } main { max-width:1120px; margin:40px auto; padding:0 24px; }
        .muted { color:#64748b; } .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; margin-top:28px; }
        .card { background:white; border:1px solid #e5eaf1; border-radius:14px; padding:22px; box-shadow:0 4px 18px #172b4d0a; }
        .status { display:inline-block; margin-top:12px; padding:5px 9px; border-radius:99px; background:#eef2f7; color:#475569; font-size:12px; }
        .table-scroll { overflow-x:auto; } .data-table { width:100%; border-collapse:collapse; text-align:left; } .data-table th, .data-table td { padding:12px 14px; border-bottom:1px solid #e5eaf1; } .data-table th { color:#475569; font-size:13px; } footer { max-width:1120px; margin:48px auto 24px; padding:0 24px; color:#64748b; font-size:13px; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header><strong>SYMFOERP</strong><nav aria-label="Navigation principale"><a href="{{ path('app_dashboard') }}">Accueil</a><a href="{{ path('app_third_parties') }}">Tiers</a><a href="{{ path('app_products') }}">Produits</a><a href="{{ path('app_sales_quotes') }}">Devis</a><a href="{{ path('app_sales_orders') }}">Commandes</a><a href="{{ path('app_purchase_orders') }}">Achats</a><a href="{{ path('app_supplier_invoices') }}">Factures fournisseurs</a><a href="{{ path('app_sales_invoices') }}">Factures</a><a href="{{ path('app_company_settings') }}">Entreprise</a>{% if app.user %}<span>{{ app.user.userIdentifier }}</span><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button type="submit">Déconnexion</button></form>{% endif %}</nav></header>
<main>{% block body %}{% endblock %}</main>
<footer>SYMFOERP · Socle applicatif Symfony 7.4 LTS</footer>
</body>
</html>
