{% extends 'base.html.twig' %}
{% block title %}Nouvelle commande fournisseur · SYMFOERP{% endblock %}
{% block body %}
<h1>Nouvelle commande fournisseur</h1>
<p><a href="{{ path('app_purchase_orders') }}">← Retour aux achats</a></p>
{% for error in errors %}<p role="alert" style="color:#b91c1c">{{ error }}</p>{% endfor %}
{% if suppliers is empty %}<section class="card">Créez d’abord une fiche tiers de catégorie fournisseur.</section>{% elseif products is empty %}<section class="card">Ajoutez d’abord des produits actifs au catalogue.</section>{% else %}
<form method="post" class="card">
<input type="hidden" name="_token" value="{{ csrf_token('purchase_order_create') }}">
<label>Fournisseur</label><select name="supplier_id" required>{% for supplier in suppliers %}<option value="{{ supplier.id }}">{{ supplier.name }}</option>{% endfor %}</select>
<label style="display:block;margin-top:16px">Notes</label><textarea name="notes" rows="2" style="width:100%"></textarea>
<h2>Lignes commandées</h2>
<div id="purchase-lines">
<div class="purchase-line" style="display:flex;gap:12px;flex-wrap:wrap;margin:12px 0">
<select name="lines[0][product_id]" required>{% for product in products %}<option value="{{ product.id }}">{{ product.sku }} · {{ product.name }} ({{ product.purchasePrice }} € HT)</option>{% endfor %}</select>
<input name="lines[0][quantity]" type="number" min="0.001" step="0.001" placeholder="Quantité" required>
</div>
</div>
<button type="button" onclick="addPurchaseLine()">Ajouter une ligne</button>
<p><button type="submit">Créer la commande</button></p>
</form>
<script>
let purchaseLineIndex = 1;
function addPurchaseLine() {
 const source = document.querySelector('.purchase-line');
 const clone = source.cloneNode(true);
 clone.querySelectorAll('select,input').forEach((field) => {
   field.name = field.name.replace(/lines\[\d+\]/, 'lines[' + purchaseLineIndex + ']');
   if (field.tagName === 'INPUT') field.value = '';
 });
 document.getElementById('purchase-lines').appendChild(clone);
 purchaseLineIndex++;
}
</script>
{% endif %}
{% endblock %}
