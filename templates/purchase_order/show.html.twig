{% extends 'base.html.twig' %}
{% block title %}{{ order.number }} · Achats fournisseurs{% endblock %}
{% block body %}
<p><a href="{{ path('app_purchase_orders') }}">← Achats fournisseurs</a></p>
<h1>{{ order.number }}</h1>
<p><strong>Fournisseur :</strong> {{ order.supplier.name }} · <strong>Date :</strong> {{ order.orderDate|date('d/m/Y') }}</p>
<p><strong>Statut :</strong> {{ statuses[order.status] }}</p>
{% if order.notes %}<p>{{ order.notes }}</p>{% endif %}
<div class="card table-scroll"><table class="data-table"><thead><tr><th>Produit</th><th>Qté commandée</th><th>Déjà reçue</th><th>Reste à recevoir</th><th>Prix achat HT</th><th>TVA</th></tr></thead><tbody>
{% for line in order.lines %}<tr>
<td>{{ line.product.sku }} · {{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.receivedQuantity }}</td><td>{{ line.remainingQuantity }}</td><td>{{ line.unitPrice }} €</td><td>{{ line.vatRate }} %</td>
</tr>{% endfor %}
</tbody></table></div>
<p>Total HT : <strong>{{ order.totalExcludingTax|number_format(2, ',', ' ') }} €</strong> · Total TTC : <strong>{{ order.totalIncludingTax|number_format(2, ',', ' ') }} €</strong></p>
{% if can_receive %}
<form method="post" action="{{ path('app_purchase_order_receive', {id: order.id}) }}" class="card">
<input type="hidden" name="_token" value="{{ csrf_token('purchase_order_receive_' ~ order.id) }}">
<h2>Enregistrer une réception</h2>
<p class="muted">Saisissez uniquement les quantités reçues lors de cette livraison. Laissez vide ou à zéro les lignes non livrées.</p>
{% for line in order.lines %}{% if line.remainingQuantity > 0 %}
<label style="display:block;margin:12px 0">{{ line.product.sku }} · {{ line.description }} — reste {{ line.remainingQuantity }}
<input type="number" name="received[{{ line.id }}]" min="0" max="{{ line.remainingQuantity }}" step="0.001" placeholder="Quantité reçue">
</label>
{% endif %}{% endfor %}
<button type="submit">Valider la réception</button>
</form>
{% endif %}
{% endblock %}
