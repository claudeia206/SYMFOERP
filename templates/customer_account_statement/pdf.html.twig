<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><style>
@page{margin:24mm 16mm 20mm}body{font-family:DejaVu Sans,sans-serif;color:#172033;font-size:9px}h1{font-size:22px;color:#172b4d}.muted{color:#64748b}.meta{margin:20px 0}table{width:100%;border-collapse:collapse;margin-top:20px}th,td{padding:7px 5px;border-bottom:1px solid #d8e0eb;text-align:right}th{background:#f1f5f9}th:nth-child(-n+3),td:nth-child(-n+3){text-align:left}.total{text-align:right;font-size:13px;margin-top:20px}.footer{position:fixed;bottom:-12mm;left:0;right:0;text-align:center;color:#64748b;font-size:8px}
</style></head><body>
<p class="muted">{{ company ? company.legalName : 'SYMFOERP' }}</p><h1>Relevé de compte client</h1>
<p><strong>{{ customer.name }}</strong><br>{{ customer.address ?? '' }}<br>{{ customer.postalCode ?? '' }} {{ customer.city ?? '' }} · {{ customer.country ?? '' }}</p>
<p class="meta">Situation arrêtée au {{ as_of|date('d/m/Y') }}</p>
<table><thead><tr><th>Date</th><th>Pièce</th><th>Libellé</th><th>Débit</th><th>Crédit</th><th>Solde dû</th></tr></thead><tbody>
{% for movement in movements %}<tr><td>{{ movement.movement_date|date('d/m/Y') }}</td><td>{{ movement.document }}</td><td>{{ movement.description }}</td><td>{{ movement.debit|number_format(2,',',' ') }} €</td><td>{{ movement.credit|number_format(2,',',' ') }} €</td><td>{{ movement.balance|number_format(2,',',' ') }} €</td></tr>{% else %}<tr><td colspan="6">Aucun mouvement.</td></tr>{% endfor %}
</tbody></table>
<p class="total"><strong>Solde client : {{ balance|number_format(2,',',' ') }} €</strong></p>
<div class="footer">Relevé de compte · {{ as_of|date('d/m/Y') }} · SYMFOERP</div></body></html>
