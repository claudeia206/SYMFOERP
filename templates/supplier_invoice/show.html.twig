{% extends 'base.html.twig' %}
{% block title %}{{ invoice.supplierInvoiceNumber }} · Facture fournisseur{% endblock %}
{% block body %}
<p><a href="{{ path('app_supplier_invoices') }}">← Factures fournisseurs</a></p>
{% for message in app.flashes('success') %}<p class="card">{{ message }}</p>{% endfor %}
{% for message in app.flashes('error') %}<p class="card">{{ message }}</p>{% endfor %}
<h1>Facture {{ invoice.supplierInvoiceNumber }}</h1>
<p><strong>Fournisseur :</strong> {{ invoice.supplier.name }} · <strong>Commande :</strong> {{ invoice.purchaseOrder.number }}</p>
<p><strong>Statut :</strong> {{ invoice.effectiveStatus }} · <strong>Date :</strong> {{ invoice.invoiceDate|date('d/m/Y') }} · <strong>Échéance :</strong> {{ invoice.dueDate|date('d/m/Y') }}</p>
<div class="card table-scroll"><table class="data-table"><thead><tr><th>Produit</th><th>Quantité réceptionnée/facturée</th><th>Prix HT</th><th>TVA</th><th>Total TTC</th></tr></thead><tbody>
{% for line in invoice.lines %}<tr><td>{{ line.product.sku }} · {{ line.description }}</td><td>{{ line.quantity }}</td><td>{{ line.unitPrice }} €</td><td>{{ line.vatRate }} %</td><td>{{ line.totalIncludingTax|number_format(2, ',', ' ') }} €</td></tr>{% endfor %}
</tbody></table></div>
<p>Total HT : {{ invoice.totalExcludingTax|number_format(2, ',', ' ') }} € · TVA : {{ invoice.totalTax|number_format(2, ',', ' ') }} € · <strong>Total TTC : {{ invoice.totalIncludingTax|number_format(2, ',', ' ') }} €</strong></p>
<p>Réglé : {{ invoice.paidAmount|number_format(2, ',', ' ') }} € · <strong>Reste dû : {{ invoice.remainingAmount|number_format(2, ',', ' ') }} €</strong></p>
{% if invoice.status == 'draft' %}
<form method="post" action="{{ path('app_supplier_invoice_receive', {id: invoice.id}) }}" class="card">
<input type="hidden" name="_token" value="{{ csrf_token('supplier_invoice_receive_' ~ invoice.id) }}">
<h2>Valider la facture reçue</h2>
<label>Date facture <input type="date" name="invoice_date" value="{{ invoice.invoiceDate|date('Y-m-d') }}" required></label>
<label>Échéance <input type="date" name="due_date" value="{{ invoice.dueDate|date('Y-m-d') }}" required></label>
<button type="submit">Valider la facture</button>
</form>
{% endif %}
{% if invoice.status in ['received', 'partially_paid'] and invoice.remainingAmount > 0 %}
<form method="post" action="{{ path('app_supplier_invoice_payment', {id: invoice.id}) }}" class="card">
<input type="hidden" name="_token" value="{{ csrf_token('supplier_invoice_payment_' ~ invoice.id) }}">
<h2>Enregistrer un règlement sortant</h2>
<label>Montant (€) <input type="number" min="0.01" max="{{ invoice.remainingAmount }}" step="0.01" name="amount" required></label>
<label>Date <input type="date" name="paid_at" value="{{ 'now'|date('Y-m-d') }}" required></label>
<label>Moyen <select name="method">{% for key,label in methods %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label>
<label>Référence <input name="reference" maxlength="120"></label>
<label>Note <input name="note"></label>
<button type="submit">Enregistrer le règlement</button>
</form>
{% endif %}
<h2>Historique des règlements</h2>
<div class="card table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Montant</th><th>Moyen</th><th>Référence</th><th>Note</th></tr></thead><tbody>
{% for payment in invoice.payments %}<tr><td>{{ payment.paidAt|date('d/m/Y') }}</td><td>{{ payment.amount }} €</td><td>{{ methods[payment.method] }}</td><td>{{ payment.reference }}</td><td>{{ payment.note }}</td></tr>{% else %}<tr><td colspan="5">Aucun règlement.</td></tr>{% endfor %}
</tbody></table></div>
{% endblock %}
