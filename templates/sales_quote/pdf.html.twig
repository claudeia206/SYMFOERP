<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{{ quote.number }} · SYMFOERP</title>
    <style>
        @page { margin: 32mm 18mm 25mm; }
        * { box-sizing: border-box; }
        body { font-family: "DejaVu Sans", sans-serif; color: #182230; font-size: 10px; line-height: 1.5; }
        .top { border-bottom: 3px solid #1d4ed8; padding-bottom: 18px; margin-bottom: 28px; }
        .brand { color: #1d4ed8; font-size: 22px; font-weight: bold; letter-spacing: .5px; }
        .muted { color: #64748b; }
        .quote-title { font-size: 24px; margin: 24px 0 4px; }
        .meta { width: 100%; margin: 22px 0; }
        .meta td { width: 50%; vertical-align: top; padding: 10px 12px; background: #f1f5f9; }
        .label { display: block; color: #64748b; font-size: 8px; text-transform: uppercase; letter-spacing: .6px; margin-bottom: 4px; }
        .customer { margin: 20px 0 28px; }
        .customer strong { font-size: 12px; }
        table.lines { width: 100%; border-collapse: collapse; margin-top: 14px; }
        .lines th { background: #172554; color: #fff; text-align: left; padding: 9px 7px; font-size: 8px; }
        .lines td { border-bottom: 1px solid #e2e8f0; padding: 9px 7px; vertical-align: top; }
        .right { text-align: right !important; white-space: nowrap; }
        .totals { width: 48%; margin: 18px 0 0 auto; border-collapse: collapse; }
        .totals td { padding: 6px 8px; border-bottom: 1px solid #e2e8f0; }
        .totals .grand td { background: #eff6ff; color: #1d4ed8; font-size: 12px; font-weight: bold; border-top: 2px solid #1d4ed8; }
        .notes { margin-top: 32px; padding: 12px; background: #f8fafc; border-left: 3px solid #94a3b8; }
        .footer { position: fixed; bottom: -15mm; left: 0; right: 0; border-top: 1px solid #cbd5e1; padding-top: 8px; color: #64748b; font-size: 8px; } .page:after { content: counter(page); }
        .status { display: inline-block; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 4px; color: #334155; }
    </style>
</head>
<body>
    <header class="top">
        <div class="brand">SYMFOERP</div>
        <div class="muted">Gestion commerciale</div>
        <h1 class="quote-title">DEVIS {{ quote.number }}</h1>
        <span class="status">{{ {'draft':'Brouillon','sent':'Envoyé','accepted':'Accepté','rejected':'Refusé'}[quote.status] ?? quote.status }}</span>
    </header>

    <table class="meta">
        <tr>
            <td><span class="label">Date du devis</span><strong>{{ quote.quoteDate|date('d/m/Y') }}</strong></td>
            <td><span class="label">Valable jusqu'au</span><strong>{{ quote.validUntil|date('d/m/Y') }}</strong></td>
        </tr>
    </table>

    <section class="customer">
        <span class="label">Proposition destinée à</span>
        <strong>{{ quote.customer.name }}</strong>
        {% if quote.customer.email %}<br>{{ quote.customer.email }}{% endif %}
        {% if quote.customer.phone %}<br>{{ quote.customer.phone }}{% endif %}
    </section>

    <h2>Détail de la proposition</h2>
    <table class="lines">
        <thead><tr><th>Désignation</th><th class="right">Quantité</th><th class="right">Prix unitaire HT</th><th class="right">TVA</th><th class="right">Total HT</th></tr></thead>
        <tbody>
        {% for line in quote.lines %}
            <tr>
                <td>{{ line.description }}</td>
                <td class="right">{{ line.quantity }}</td>
                <td class="right">{{ line.unitPrice|number_format(2, ',', ' ') }} €</td>
                <td class="right">{{ line.vatRate|number_format(2, ',', ' ') }} %</td>
                <td class="right">{{ line.totalExcludingTax|number_format(2, ',', ' ') }} €</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <table class="totals">
        <tr><td>Total HT</td><td class="right">{{ quote.totalExcludingTax|number_format(2, ',', ' ') }} €</td></tr>
        <tr><td>Total TVA</td><td class="right">{{ quote.totalTax|number_format(2, ',', ' ') }} €</td></tr>
        <tr class="grand"><td>Total TTC</td><td class="right">{{ quote.totalIncludingTax|number_format(2, ',', ' ') }} €</td></tr>
    </table>

    {% if quote.notes %}
        <section class="notes"><strong>Notes et conditions</strong><br>{{ quote.notes|nl2br }}</section>
    {% endif %}

    <footer class="footer">Document généré par SYMFOERP · {{ quote.number }} · Page <span class="page"></span></footer>
</body>
</html>
