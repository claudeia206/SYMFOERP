{% extends 'base.html.twig' %}
{% block title %}Créer un utilisateur · SYMFOERP{% endblock %}
{% block body %}
<p class="muted"><a href="{{ path('app_admin_users_index') }}">← Utilisateurs</a></p><h1>Créer un utilisateur</h1>
<section class="card">{% if error %}<p role="alert">{{ error }}</p>{% endif %}
<form method="post" action="{{ path('app_admin_users_new') }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin_user_create') }}">
<p><label for="email">Adresse e-mail</label><br><input id="email" name="email" type="email" maxlength="180" required autocomplete="email" value="{{ email }}"></p>
<p><label for="password">Mot de passe temporaire (12 caractères minimum)</label><br><input id="password" name="password" type="password" minlength="12" required autocomplete="new-password"></p>
<p><label><input type="checkbox" name="is_admin" value="1"> Donner le rôle administrateur</label></p>
<button type="submit">Créer le compte</button></form></section>
{% endblock %}
